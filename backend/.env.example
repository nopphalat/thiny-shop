# =========================================
# THINY SHOP — Backend Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# =========================================

# === Local Development (SQLite file) ===
# ปล่อยว่างหรือไม่ตั้งก็ได้ — จะใช้ thiny_shop.db local
TURSO_URL=
TURSO_AUTH_TOKEN=

# === Production (Turso) ===
# สมัครที่ https://turso.tech แล้วรัน:
#   turso db create thiny-shop --location sin
#   turso db show thiny-shop --url      → ใช้เป็น TURSO_URL
#   turso db tokens create thiny-shop   → ใช้เป็น TURSO_AUTH_TOKEN
# TURSO_URL=libsql://thiny-shop-username.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSI...

# === Server config ===
SERVER_PORT=5000

# === CORS (Frontend URL) ===
# Local: http://localhost:8000
# Production: https://thiny-shop.pages.dev (Cloudflare Pages URL)
# Multiple: comma-separated
CORS_ORIGIN=http://localhost:8000
